flowchart TD
    O["Operator"]:::ext
    G["Telegram"]:::ext
    W["Ops watchdog"]:::svc
    A["OpenCode agent"]:::ext
    S["Ingest supervisor"]:::svc
    D["Ingest driver"]:::svc
    P[("PostgreSQL")]:::store

    O <--> G <--> W
    W -->|"escalates"| A
    W -->|"restarts"| S
    S -->|"relaunches"| D
    D --> P

    classDef svc fill:#E3F2FD,stroke:#1565C0,color:#0D47A1
    classDef store fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20
    classDef ext fill:#FFF3E0,stroke:#EF6C00,color:#E65100
    classDef proposed fill:#F5F5F5,stroke:#9E9E9E,stroke-dasharray:5 5,color:#616161
